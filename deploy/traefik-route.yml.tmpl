# Generated by plats scripts/deploy.sh from deploy/traefik-route.yml.tmpl — do not edit by hand,
# change plats.env (PLATS_HOST / PLATS_BIND / TRAEFIK_CERTRESOLVER) and re-run deploy.sh.
# hosh.it box standard: edge Traefik (host network, file provider) → loopback port of the container.
# REVERT = delete this file (Traefik hot-reloads the directory).
http:
  routers:
    plats:
      rule: "Host(`__HOST__`)"
      service: plats
      entryPoints: [__ENTRYPOINT__]
      middlewares: [plats-hsts]
      tls: __TLS__
  middlewares:
    plats-hsts:
      headers:
        stsSeconds: 31536000
        stsIncludeSubdomains: true
  services:
    plats:
      loadBalancer:
        servers:
          - url: "http://__BIND__"
